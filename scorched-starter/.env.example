# Copy to .env and fill in. Never commit .env itself.

RESEND_API_KEY=
CONTACT_TO=
CONTACT_FROM=

# Supabase (Supabase project -> Settings -> API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin dashboard password
ADMIN_PASSWORD=

# Signs admin/location session tokens (lib/admin-session.ts)
ADMIN_SESSION_SECRET=

# Signs customer login-link and session tokens (lib/customer-session.ts)
CUSTOMER_SESSION_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Site URL (Stripe redirects, unsubscribe links, webhook callbacks)
NEXT_PUBLIC_SITE_URL=

SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_IDS=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Analytics. Both are public identifiers, safe to expose client-side, and both
# are gated on being set: leave them blank outside production so preview and
# local traffic stays out of the real Meta and Google properties.
#
# NEXT_PUBLIC_ values are inlined at build time, so setting either one only
# takes effect on the next deploy.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=
PLAID_TOKEN_ENC_KEY=

CRON_SECRET=


# --- Marketing: email + SMS ------------------------------------------------

# Telnyx. API key and public key come from the Mission Control portal
# (Auth -> API Keys, and Auth -> Public Key). The public key is base64 of 32
# raw bytes and is what verifies the Ed25519 webhook signature.
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
# Messaging profile the number belongs to. Its webhook must point at
# /api/webhooks/telnyx.
TELNYX_MESSAGING_PROFILE_ID=
# E.164. A local 10DLC long code registered to an approved campaign.
TELNYX_FROM_NUMBER=

# Sustained send rate. One cron run (every 5 minutes) may send this many times
# five. Deliberately conservative: a newly approved 10DLC campaign gets a low
# carrier-assigned throughput, and exceeding it means messages are filtered
# rather than queued. Raise once the campaign's assigned rate is known.
SMS_MAX_PER_MINUTE=12

# Planning figure for the cost estimate in the campaign composer, in dollars
# per SMS segment per recipient. MMS bills higher and is not covered by it.
SMS_COST_PER_SEGMENT=0.004

# Local hours in America/Denver. The window wraps midnight: 20 to 9 means no
# texts go out between 8pm and 9am.
SMS_QUIET_HOURS_START=20
SMS_QUIET_HOURS_END=9

# --- Marketing email -------------------------------------------------------

# Marketing email sends from a separate subdomain so a spam complaint can never
# damage delivery of booking and waiver mail from scorchedstudio.com.
RESEND_MARKETING_FROM="Scorched Studio <hello@news.scorchedstudio.com>"
# Resend renamed audiences to segments. This still holds the id that the
# Resend dashboard now labels "segment".
RESEND_AUDIENCE_ID=
# Signing secret for the Resend webhook (Svix). Starts with whsec_.
RESEND_WEBHOOK_SECRET=

# The master gate. While this is anything but exactly "true", every provider
# call logs what it would have sent and returns a fake handle. Nothing reaches
# a real phone or inbox. Leave it false everywhere except production, and only
# after the manual checklist in docs/marketing/SETUP.md has been run.
MARKETING_LIVE=false
